<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1565C0"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✈ Airplane Mode Lock"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parental Control"
                android:textColor="#BBDEFB"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="Checking status..." />

            <TextView
                android:id="@+id/protectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginTop="6dp"
                android:text="" />
        </LinearLayout>

        <!-- Password Setup Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set Parental Password"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/currentPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Current password (leave blank if not set yet)"
                android:inputType="textPassword"
                android:layout_marginBottom="10dp"
                android:padding="12dp"
                android:background="@android:drawable/edit_text" />

            <EditText
                android:id="@+id/newPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="New password (min 4 characters)"
                android:inputType="textPassword"
                android:layout_marginBottom="10dp"
                android:padding="12dp"
                android:background="@android:drawable/edit_text" />

            <EditText
                android:id="@+id/confirmPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirm new password"
                android:inputType="textPassword"
                android:layout_marginBottom="16dp"
                android:padding="12dp"
                android:background="@android:drawable/edit_text" />

            <Button
                android:id="@+id/savePasswordBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Password"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Bypass / Travel Mode Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Travel / Bypass Mode"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set a separate short bypass code. When you are on an actual plane, enter this code on the lock screen to temporarily disable all restrictions."
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/bypassCodeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Set bypass code (e.g. 1234)"
                android:inputType="textPassword"
                android:layout_marginBottom="10dp"
                android:padding="12dp"
                android:background="@android:drawable/edit_text" />

            <Button
                android:id="@+id/saveBypassBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Bypass Code"
                android:backgroundTint="#455A64"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/bypassStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/toggleBypassBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Turn Bypass Mode ON"
                android:backgroundTint="#00796B"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Battery Saver Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battery Saver (Always ON)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/batterySaverStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking..."
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Requires one-time ADB setup. Connect phone to PC and run:\n\nadb shell pm grant com.parentalcontrol.airplanelock android.permission.WRITE_SECURE_SETTINGS"
                android:textSize="12sp"
                android:textColor="#666666"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Device Admin Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prevent App Uninstall"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable Device Admin so your child cannot uninstall this app from Settings."
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/activateAdminBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Activate Device Admin"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Instructions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E3F2FD"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How it works:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Set your parental password above\n2. Enable Device Admin (recommended)\n3. When your child tries to turn on Airplane Mode, a password screen will appear\n4. They must enter the correct password to proceed, or turn Airplane Mode back off\n5. After 5 wrong attempts, the screen locks for 60 seconds"
                android:textSize="13sp"
                android:textColor="#333333"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
