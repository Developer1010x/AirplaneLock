<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#1A237E"
    android:padding="32dp">

    <!-- Lock Icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="64sp"
        android:layout_marginBottom="16dp" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parental Control"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✈ Airplane Mode Blocked"
        android:textColor="#EF9A9A"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <!-- Message -->
    <TextView
        android:id="@+id/messageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Airplane mode was turned on.\nEnter the parental password to allow it,\nor turn it back off."
        android:textColor="#BBDEFB"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Password input -->
    <EditText
        android:id="@+id/passwordInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter parental password"
        android:hintTextColor="#7986CB"
        android:textColor="#FFFFFF"
        android:inputType="textPassword"
        android:gravity="center"
        android:textSize="18sp"
        android:padding="14dp"
        android:background="#283593"
        android:layout_marginBottom="16dp" />

    <!-- Attempts warning -->
    <TextView
        android:id="@+id/attemptsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#EF9A9A"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Unlock button -->
    <Button
        android:id="@+id/unlockBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Unlock with Password"
        android:backgroundTint="#3949AB"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="14dp"
        android:layout_marginBottom="12dp" />

    <!-- Action button — label is set in code based on what was blocked -->
    <Button
        android:id="@+id/turnOffAirplaneBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Restore Setting"
        android:backgroundTint="#B71C1C"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:padding="12dp" />

    <!-- Travel/bypass mode button — hidden unless a bypass code is set -->
    <Button
        android:id="@+id/bypassBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Use Travel / Bypass Code"
        android:backgroundTint="#37474F"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:padding="10dp"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This screen will close automatically when\nthe setting is restored."
        android:textColor="#5C6BC0"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="16dp" />

</LinearLayout>
